---
// Layout do painel: sem cabeçalho, rodapé e WhatsApp do site; fora do Google.
import '../global/global.css';
import './layout-painel.css';
const { titulo = 'Painel' } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#18261c" />
    <title>{titulo} · Torra Miúda</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fontes/schibsted-grotesk-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fontes/alegreya-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="corpo-painel">
    <slot />
  </body>
</html>
