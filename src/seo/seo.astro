---
import { CONFIG } from '../dados/dados.js';

const { titulo, descricao, imagem = '/compartilhar.png', dados = [], semIndice = false } = Astro.props;
const tituloCompleto = titulo ? `${titulo} · Torra Miúda` : 'Torra Miúda Cafés Especiais · Café da Serra de Baturité, torrado depois do seu pedido';
const canonico = new URL(Astro.url.pathname, Astro.site).href;
const imagemAbsoluta = new URL(imagem, Astro.site).href;

const negocio = {
  '@context': 'https://schema.org',
  '@type': 'Store',
  '@id': `${CONFIG.site}/#negocio`,
  name: CONFIG.nome,
  legalName: CONFIG.razaoSocial,
  url: CONFIG.site,
  telephone: CONFIG.telefone,
  email: CONFIG.email,
  image: imagemAbsoluta,
  priceRange: 'R$ 42 – R$ 230',
  address: {
    '@type': 'PostalAddress',
    streetAddress: CONFIG.enderecos.retirada.rua,
    addressLocality: CONFIG.enderecos.retirada.cidade,
    addressRegion: CONFIG.enderecos.retirada.uf,
    addressCountry: 'BR',
  },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'], opens: '10:00', closes: '18:00' },
  ],
  sameAs: [CONFIG.instagram, CONFIG.tiktok],
  aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.9', reviewCount: CONFIG.google.avaliacoes, bestRating: '5' },
};
const blocos = [negocio, ...dados];
---

<title>{tituloCompleto}</title>
<meta name="description" content={descricao} />
<link rel="canonical" href={canonico} />
{semIndice && <meta name="robots" content="noindex" />}
<meta property="og:type" content="website" />
<meta property="og:locale" content="pt_BR" />
<meta property="og:site_name" content={CONFIG.nome} />
<meta property="og:title" content={tituloCompleto} />
<meta property="og:description" content={descricao} />
<meta property="og:url" content={canonico} />
<meta property="og:image" content={imagemAbsoluta} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
{blocos.map((bloco) => <script type="application/ld+json" set:html={JSON.stringify(bloco)} />)}
