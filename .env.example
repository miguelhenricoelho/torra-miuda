# Mostra as etiquetas [REVISAR COM O CLIENTE] na tela (só para revisão interna)
PUBLIC_MODO_REVISAO=false

# Supabase (Project Settings > API). Só a chave pública (anon) entra aqui.
# Sem estas duas, o site usa o catálogo de exemplo e o painel abre só a demonstração.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# true = mostra também a demonstração do painel quando o Supabase está ligado (portfólio)
PUBLIC_PAINEL_DEMONSTRACAO=false

# NUNCA coloque aqui a service_role key: ela vive só nos segredos da função no Supabase.
